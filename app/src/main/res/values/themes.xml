<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Se o projeto já tiver um tema (ex.: Theme.NomeDoApp), copie os <item> para ele -->
    <style name="Theme.AppRegistros" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primaria</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorSecondary">@color/destaque</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/primaria_escura</item>
    </style>

    <!-- Botões -->
    <style name="BotaoPrimario" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/altura_botao</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/primaria</item>
        <item name="android:textColor">@color/branco</item>
        <item name="iconTint">@color/branco</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="BotaoDestaque" parent="BotaoPrimario">
        <item name="backgroundTint">@color/destaque</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="iconTint">@color/texto_principal</item>
    </style>

    <style name="BotaoSecundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/altura_botao</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primaria</item>
        <item name="iconTint">@color/primaria</item>
        <item name="strokeColor">@color/primaria</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="BotaoPerigo" parent="BotaoSecundario">
        <item name="android:textColor">@color/perigo</item>
        <item name="iconTint">@color/perigo</item>
        <item name="strokeColor">@color/perigo</item>
    </style>

    <!-- Textos -->
    <style name="TextoRotulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/texto_rotulo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:layout_marginTop">@dimen/espaco_medio</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="TextoValor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/texto_valor</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/altura_campo</item>
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
    </style>

    <style name="BotaoVoltar">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:src">@drawable/ic_voltar</item>
        <item name="android:contentDescription">@string/desc_voltar</item>
    </style>

    <style name="TituloCabecalho">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textSize">@dimen/texto_titulo_tela</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_sobre_primaria</item>
    </style>
</resources>
