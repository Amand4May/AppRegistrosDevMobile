<?xml version="1.0" encoding="utf-8"?>
<!-- Item da lista (usado pelo Adapter) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:minHeight="88dp"
    android:orientation="horizontal">

    <!-- Faixa de cor da prioridade: no Java, setBackgroundColor conforme Alta/Média/Baixa -->
    <View
        android:id="@+id/viewPrioridade"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/prioridade_media" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/texto_principal"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Inspeção da linha 3" />

            <TextView
                android:id="@+id/tvItemCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/texto_principal"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Lista de controle" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvItemDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp"
            tools:text="Verificar sensores, nível de óleo e proteção da esteira antes do turno." />

        <TextView
            android:id="@+id/tvItemSetor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/primaria"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Montagem – Linha 3 · 16/11/2026" />
    </LinearLayout>
</LinearLayout>
