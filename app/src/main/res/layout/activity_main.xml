<?xml version="1.0" encoding="utf-8"?>
<!-- TELA 1 · Início -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primaria"
        android:orientation="vertical"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="40dp"
        android:paddingEnd="@dimen/margem_tela"
        android:paddingBottom="28dp">

        <View
            android:layout_width="48dp"
            android:layout_height="6dp"
            android:layout_marginBottom="16dp"
            android:background="@color/destaque" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/inicio_titulo"
            android:textColor="@color/texto_sobre_primaria"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/inicio_subtitulo"
            android:textColor="#CFD8E3"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <!-- Contador de registros -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_contador"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/espaco_grande">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lista" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/inicio_total_rotulo"
                    android:textColor="@color/texto_secundario"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvTotalRegistros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/primaria"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    tools:text="12" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNovoRegistro"
                style="@style/BotaoDestaque"
                android:layout_width="match_parent"
                android:layout_marginTop="32dp"
                android:text="@string/btn_novo_registro"
                app:icon="@drawable/ic_adicionar"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerRegistros"
                style="@style/BotaoPrimario"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/espaco_medio"
                android:text="@string/btn_ver_registros" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/espaco_medio"
        android:text="@string/inicio_offline"
        android:textColor="@color/texto_secundario"
        android:textSize="13sp" />
</LinearLayout>
