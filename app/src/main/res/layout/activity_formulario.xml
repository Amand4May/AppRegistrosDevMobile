<?xml version="1.0" encoding="utf-8"?>
<!-- TELA 3 · Cadastro / Edição (a mesma tela serve para os dois) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical"
    tools:context=".FormularioActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/primaria"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="@dimen/margem_tela">

        <ImageButton
            android:id="@+id/btnVoltarForm"
            style="@style/BotaoVoltar" />

        <!-- No modo edição, o Java troca para @string/form_titulo_editar -->
        <TextView
            android:id="@+id/tvTituloFormulario"
            style="@style/TituloCabecalho"
            android:text="@string/form_titulo_novo" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <TextView
                style="@style/TextoRotulo"
                android:layout_marginTop="0dp"
                android:text="@string/campo_titulo" />

            <EditText
                android:id="@+id/etTitulo"
                style="@style/Campo"
                android:hint="@string/campo_titulo_dica"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="60" />

            <TextView
                style="@style/TextoRotulo"
                android:text="@string/campo_categoria" />

            <Spinner
                android:id="@+id/spCategoria"
                android:layout_width="match_parent"
                android:layout_height="@dimen/altura_campo"
                android:background="@drawable/bg_campo"
                android:entries="@array/categorias"
                android:paddingStart="8dp"
                android:spinnerMode="dropdown" />

            <TextView
                style="@style/TextoRotulo"
                android:text="@string/campo_setor" />

            <EditText
                android:id="@+id/etSetor"
                style="@style/Campo"
                android:hint="@string/campo_setor_dica"
                android:importantForAutofill="no"
                android:inputType="textCapSentences" />

            <TextView
                style="@style/TextoRotulo"
                android:text="@string/campo_responsavel" />

            <EditText
                android:id="@+id/etResponsavel"
                style="@style/Campo"
                android:hint="@string/campo_responsavel_dica"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/TextoRotulo"
                android:text="@string/campo_prioridade" />

            <RadioGroup
                android:id="@+id/rgPrioridade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@+id/rbMedia"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbBaixa"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/altura_campo"
                    android:layout_weight="1"
                    android:buttonTint="@color/prioridade_baixa"
                    android:text="@string/prioridade_baixa"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbMedia"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/altura_campo"
                    android:layout_weight="1"
                    android:buttonTint="@color/prioridade_media"
                    android:text="@string/prioridade_media"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbAlta"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/altura_campo"
                    android:layout_weight="1"
                    android:buttonTint="@color/prioridade_alta"
                    android:text="@string/prioridade_alta"
                    android:textSize="16sp" />
            </RadioGroup>

            <TextView
                style="@style/TextoRotulo"
                android:text="@string/campo_descricao" />

            <EditText
                android:id="@+id/etDescricao"
                style="@style/Campo"
                android:gravity="top|start"
                android:hint="@string/campo_descricao_dica"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="5"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/campo_obrigatorio"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Barra de ações fixa no rodapé -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="@dimen/espaco_medio">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            style="@style/BotaoSecundario"
            android:layout_width="0dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/btn_cancelar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvar"
            style="@style/BotaoPrimario"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/btn_salvar" />
    </LinearLayout>
</LinearLayout>
